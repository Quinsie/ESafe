    "@testing-library/user-event": "14.6.1",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.0",
    "typescript": "7.0.2",
