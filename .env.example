# Copy to .env and replace every CHANGE_ME value. Never commit .env.
TZ=Asia/Seoul

POSTGRES_USER=esafe
POSTGRES_PASSWORD=CHANGE_ME
LIVE_DATABASE_NAME=esafe_live
DEMO_DATABASE_NAME=esafe_demo

ESAFE_SESSION_SECRET_LIVE=CHANGE_ME
ESAFE_SESSION_SECRET_DEMO=CHANGE_ME
ESAFE_PUBLIC_USER_PASSWORD=CHANGE_ME

UPSTAGE_API_KEY=CHANGE_ME
DATA_GO_KR_SERVICE_KEY=CHANGE_ME

NFDS_ENABLED=true
NFDS_BASE_URL=https://www.nfds.go.kr
KMA_WARNING_BASE_URL=https://apis.data.go.kr
DISASTER_MESSAGE_BASE_URL=https://www.safetydata.go.kr

UPSTAGE_CHAT_MODEL=solar-pro3
UPSTAGE_EMBED_QUERY_MODEL=solar-embedding-2-query
UPSTAGE_EMBED_PASSAGE_MODEL=solar-embedding-2-passage
UPSTAGE_COST_HARD_STOP_USD=450

BACKUP_CRON=30 18 * * *
BACKUP_RETENTION_GENERATIONS=7
